# ── ElevenLabs voice (optional) ─────────────────────────────────────────────
# Without a key the dashboard uses the browser's own speech APIs (Chrome/Edge/Brave).
# Create a key at https://elevenlabs.io/app/settings/api-keys with the default
# (all) permissions — it must allow Text to Speech AND Speech to Text.
# Paste it here before OR after starting the server: the server watches this file
# and reloads it, and the HUD shows whether ElevenLabs accepted the key.
# Keep this file private. It is git-ignored and created with mode 600.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Hermes profile whose tools, skills, memory, browser, and MCP servers are
# inherited. Changing this requires a restart.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH (restart required).
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory, permission mode, idle timeout in seconds, dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
JARVIS_TIMEOUT=120
JARVIS_PORT=8730

# 1 = open the dashboard in your browser on start. Use 0 on headless or remote
# machines. ./start.sh --background always uses 0.
JARVIS_OPEN=1
